# DS41RT example: 2 RTX + 6 Spark, pure unreplicated TP6 x EP1.
#
# ============================================================================
# OPT-IN CANDIDATE, NOT RELEASE-QUALIFIED. This is the pure tensor-parallel
# six-rank layout: one group of six ranks, each holding a disjoint 2304/6 = 384
# column slice of EVERY routed expert. No expert is duplicated (EP=1 means a
# single unreplicated group, not six copies), so this is not an expert-parallel
# layout and it does not reuse the TP2xEP3/TP3xEP2 replicated-group contract.
#
# It requires the extra `spark_tp6` AOT role in the Spark image; the universal
# pair named below carries it (see README.md here). An older v8 image without
# the advertised role label is rejected before any service change. Bounded
# final-image functional checks for this geometry passed on 1 and 2 RTX on the
# v9 images (docs/release-v9-notes.md); the canonical frozen six-rank qualifier
# was NOT run, so quality, readiness, memory and performance are not established
# here.
# ============================================================================
#
#   ./run.sh --config examples/configs/tp6ep1-native.config --dry-run
#
# group = rank / 6, tp_rank = rank % 6, so every rank is in group 0:
#   ostrich,dodo,emu,kiwi,rhea,moa -> group 0, tp_rank 0..5
#
# The RTX-local routed layers stay the coordinator's own layout (N20 dual-RTX or
# all-40 remote on a single RTX); the six Spark ranks hold the TP6 shards of
# every routed expert of every remote layer.

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable

RTX_GPUS=2

SPARK_COUNT=6
SPARK_TP=6
SPARK_EP=1

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_4_HOST=rhea
SPARK_5_HOST=moa
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
SPARK_4_LANE_A=10.55.0.5
SPARK_5_LANE_A=10.55.0.6

# Isolated secondary rail; native candidate transport still dials LANE_A.
SPARK_0_LANE_B=10.55.1.1
SPARK_1_LANE_B=10.55.1.2
SPARK_2_LANE_B=10.55.1.3
SPARK_3_LANE_B=10.55.1.4
SPARK_4_LANE_B=10.55.1.5
SPARK_5_LANE_B=10.55.1.6

# Promoted release pair (universal images; `run.sh` selects the tp6 role this
# topology needs). Six ranks need the Spark image on rhea/moa too. See README.md.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v12
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v12

# Budget: MemTotal varies by host. The tested fleet-wide floor is the minimum
# of (MemTotal - 20 GiB) across all six hosts: 109,119,320,064 bytes. TP6 needs
# 40 * 1,203,240,960 = 48,129,638,400 B for all 40 remote layers, so even the
# 100 GiB fallback admits the whole backbone on weights alone.
SPARK_DEVICE_BUDGET_BYTES=109119320064
