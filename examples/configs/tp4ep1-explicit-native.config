# DS41RT example: 2 RTX + 4 Spark, explicit TP4 x EP1 (default geometry).
#
# This is the explicit form of the shipped legacy default. It is the control arm
# for a TP2 x EP2 A/B: use ./run.sh with ds41rt.config for the same geometry
# without the explicit keys. It is an illustrative launch config, not the
# measured artifact; see docs/tp-ep-configuration.md for current results.
#
#   ./run.sh --config examples/configs/tp4ep1-explicit-native.config --dry-run
#
# group = rank / 4, tp_rank = rank % 4; every rank is one TP rank of one group.

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable

RTX_GPUS=2

SPARK_COUNT=4
SPARK_TP=4
SPARK_EP=1

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
# Secondary rail uses an isolated subnet with matching host numbers.
SPARK_0_LANE_B=10.55.1.1
SPARK_1_LANE_B=10.55.1.2
SPARK_2_LANE_B=10.55.1.3
SPARK_3_LANE_B=10.55.1.4

# The explicit control arm uses the promoted release pair unchanged; TP4 needs
# no extra Spark expert role. See README.md here for the role caveats.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v15
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v15
