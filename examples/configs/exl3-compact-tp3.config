# DS41RT example: 1 RTX + 3 Spark, compact EXL3 (DeepSeek-V4.1 K3.25), TP3.
#
# ============================================================================
# V10 CANDIDATE PROFILE - NOT RELEASE-QUALIFIED. The compact layout shape is
# generalized from the measured two-rank EXL3 arm (`SPARK_COUNT=2`, one RTX
# held to a 32 GiB ceiling, uniform-K2 diffbot checkpoint at the time); the
# checkpoint target is now the audited K3.25 publication below. The layout is
# IMPLICIT: SPARK_COUNT=3 with NO SPARK_TP/SPARK_EP keys selects the compact
# EXL3 TP3 topology (each rank serves the 2304/3 = 768-column shard).
# It is not the explicit native TP3EP1 profile in
# tp3ep1-native.config; the explicit keys are native-checkpoint-only and are
# rejected with this format. No memory, correctness, performance or readiness
# claim is attached to the three-rank compact arm. Targets the v10 release
# pair and is never selected automatically.
# ============================================================================
#
#   ./run.sh --config examples/configs/exl3-compact-tp3.config --dry-run
#
# Checkpoint: checkpoint-native K3.25 publication; the metadata audit measured
# a mixed-projection staged trellis with manifest bit family [3,4], which the
# launcher derives as family tag `k34` from the checkpoint's declared bits: 3.
# All 66 snapshot files verified complete in the standard local HF cache.
#
# Compact rules the launcher enforces for this file: EXPERT_FORMAT=exl3, one
# RTX GPU (hard ceiling, clamped to physical VRAM by the selector), non-paired
# disjoint EXL3 packages per rank, and PREFILL_BATCH_TOKENS clamped to 256 —
# a bounded starting prefill pending qualification, not a proven fit for the
# 32GiB ceiling (KV defaults to 2GiB). RTX_EXPERT_LAYERS is left unset exactly
# as in the measured two-rank compact arm: auto keeps the published compact
# behavior, and this file makes no coordinator placement claim. Per-host
# EXL3 package admission requires the k34-family tp3-rank0/1/2 packages for
# every worker capacity at or below the resolved capacity, and fails before
# any service change.

MODEL_ID=wrldsuksgo2mars/DeepSeek-V4.1-EXL3-K3.25-v1
MODEL_VARIANT=flash
MODEL_REVISION=cfd4ca1d1934a8e81dd2d7515598d4ce288e8b88
EXPERT_FORMAT=exl3
SPARKINFER_EXL3=auto
EXL3_PAIRED_TP4=off

RTX_GPUS=1

# Implicit compact TP3: no SPARK_TP/SPARK_EP keys here or below.
SPARK_COUNT=3

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3

MEMORY_RESERVATION=32GiB
KV_POOL_SIZE=2GiB
PREFILL_BATCH_TOKENS=256
DSPARK=on

# v10 target images; EXL3 compact serving uses the Spark image's EXL3
# packages, so the Spark image must ship the k34-family tp3-rank{0,1,2}
# variants this launch admits preflight.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v12
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v12
