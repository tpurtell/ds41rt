# DS41RT example: 2 RTX + 4 Spark, replicated TP2 x EP2 (opt-in candidate).
#
# Status: EXPERIMENT COMPLETED, NOT ACCEPTED, NOT RELEASE-QUALIFIED. The native
# daemon support for TP2 x EP2 and the TP2 Spark kernel artifacts have landed and
# run; the arm completed its scope with a strict quality FAIL (not accepted).
# This file is an illustrative launch config, not the measured artifact; see
# docs/tp-ep-configuration.md for results and launcher limits. A dry-run does
# not prove the launch is feasible.
#
#   ./run.sh --config examples/configs/tp2ep2-native.config --dry-run
#
# group = rank / 2, tp_rank = rank % 2:
#   rank 0 -> group 0 tp_rank 0    rank 2 -> group 1 tp_rank 0
#   rank 1 -> group 0 tp_rank 1    rank 3 -> group 1 tp_rank 1
#
# The RTX-local routed layers stay TP2; the remote Spark layers are TP2 inside
# each of the two replicated groups.

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable

RTX_GPUS=2

SPARK_COUNT=4
SPARK_TP=2
SPARK_EP=2

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
# Secondary rail uses an isolated subnet with matching host numbers.
SPARK_0_LANE_B=10.55.1.1
SPARK_1_LANE_B=10.55.1.2
SPARK_2_LANE_B=10.55.1.3
SPARK_3_LANE_B=10.55.1.4

# Promoted release pair (universal images; `run.sh` selects the tp2 role this
# topology needs). See README.md here for the role/qualification caveats.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v14
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v14

# Budget: the tested candidate floor is SPARK_DEVICE_BUDGET_BYTES=109119320064
# (130,661,208,064 B MemTotal - 20 GiB), the value used by the G1 and six-rank
# runs. The default 100 GiB is a conservative fallback and is never a cap; do
# not assume 128 GiB from an advertised 128 GB part, and do not lower this on a
# transient undercount; admission failures at the real boundary are a correct
# rejection.
SPARK_DEVICE_BUDGET_BYTES=109119320064
