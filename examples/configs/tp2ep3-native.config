# DS41RT example: 2 RTX + 6 Spark, replicated TP2 x EP3.
#
# ============================================================================
# EXPERIMENT COMPLETED, NOT ACCEPTED, NOT RELEASE-QUALIFIED. The six Spark hosts
# are rhea/moa as global ranks 4/5 (see docs/cluster-hosts.md). Quality was not
# accepted and the release is not qualified; this file carries no memory,
# correctness, performance or readiness claim. rhea/moa are ordinary
# benchmark/development hosts under the current permission. This is an
# illustrative launch config, not the measured artifact; see
# docs/tp-ep-configuration.md.
# ============================================================================
#
#   ./run.sh --config examples/configs/tp2ep3-native.config --dry-run
#
# group = rank / 2, tp_rank = rank % 2:
#   ostrich,dodo -> group 0    emu,kiwi -> group 1    rhea,moa -> group 2
#
# RTX-local routed layers stay TP2 across the two RTX cards; the six Spark
# ranks hold TP2 shards of every routed expert in three replicated groups.

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable

RTX_GPUS=2

SPARK_COUNT=6
SPARK_TP=2
SPARK_EP=3

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_4_HOST=rhea
SPARK_5_HOST=moa
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
# rhea/moa fabric A; their fabric B is 10.55.0.11/12. The secondary rail stays
# unset because the candidate launcher is single-rail A-only; the legacy
# 10.55.0.5-8 LANE_B defaults are stale and unchanged.
SPARK_4_LANE_A=10.55.0.5
SPARK_5_LANE_A=10.55.0.6

# Candidate releases built with DS41RT_RELEASE_SPARK_TP_ROLES=tp2:
#   ./build.sh --config examples/configs/tp2ep3-native.config
COORDINATOR_DOCKER_INFERENCE=ds41rt-coordinator:tp2ep3-candidate
SPARK_EXPERT_DOCKER_INFERENCE=ds41rt-spark-expert:tp2ep3-candidate

# Budget: MemTotal varies by host. The tested fleet-wide budget is the minimum
# of (MemTotal - 20 GiB) across all six hosts: 109,119,320,064 bytes.
# This overrides the 100 GiB default; runtime load/serve admission still applies.
# Do not substitute a newer host's larger budget or assume 128 GiB.
SPARK_DEVICE_BUDGET_BYTES=109119320064
