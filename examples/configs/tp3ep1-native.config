# DS41RT example: 1 RTX + 3 Spark, official native checkpoint, TP3 x EP1.
#
# ============================================================================
# V10 CANDIDATE PROFILE - NOT RELEASE-QUALIFIED. This opt-in overlay is
# launcher support for the explicit `TP3xEP1` geometry: three Spark ranks form
# ONE unreplicated group (EP1 means a single group, no duplication). The
# daemon, transport, N-plane reduction and the SM121 `spark_tp3` expert role
# already exist and ship in the universal release pair, but nothing here
# establishes quality, memory, performance or readiness for this three-rank
# layout; the earlier TP3xEP2 experiments recorded a strict quality FAIL.
# This file targets the v10 release pair and is not selected automatically.
# ============================================================================
#
#   ./run.sh --config examples/configs/tp3ep1-native.config --dry-run
#
# group = rank / 3, tp_rank = rank % 3, so every rank is in group 0:
#   ostrich,dodo,emu -> group 0, tp_rank 0,1,2

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
MODEL_REVISION=dba1be0a40aa45a94ad051997016db3960a90277
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable
EXL3_PAIRED_TP4=off

RTX_GPUS=1
# The RTX holds the first five routed layers (0-4); each Spark rank starts at
# layer 5 and holds the other 35 (5-39). `5` is an explicit local count on an
# explicit topology, which is the supported handoff path: run.sh passes
# `--placement-directory`, the coordinator publishes plan.json with
# rtx_expert_layers=5 / spark_first_layer=5, and every worker is started with
# `--first-layer 5` before the launch acknowledges readiness. `auto` and `0`
# have no local boundary to hand off on one RTX and keep the historical
# no-handoff shape, where workers start at layer 0 and reserve all 40 layers;
# this profile deliberately does not use that shape.
RTX_EXPERT_LAYERS=5

# Placement precedent, not TP3 qualification. The same 5-local / 35-remote
# single-RTX shape was functionally exercised on the final v9 images for the
# official TP6xEP1 geometry (docs/release-v9-tp6-1rtx-official.md: "RTX layers
# 5; Spark first layer 5; remote_layers=35", worker contract
# `first_layer=5 layers=35`), and the v8 1-RTX baseline measured the same 5/35
# dispatch (scripts/bench/tp6-candidate-flags.md). The launcher handoff is
# topology-independent, but that evidence is TP6: it does not qualify TP3 on
# quality, memory, performance or readiness, and no such TP3 result exists.

# Explicit keys are mandatory for a native three-rank launch: count 3 without
# them is the compact EXL3 TP3 profile, never this one.
SPARK_COUNT=3
SPARK_TP=3
SPARK_EP=1

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3

# v10 target images. The universal role set advertises tp2;tp3;tp6, and
# `run.sh` selects the `tp3` expert role this topology needs; the published
# v9 pair already carries it, so point both names at the v10 pair on release.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v10
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v10

# Budget: TP3 per-rank layer bytes are the exact 2304/3 = 768-column shard,
# 2,406,481,920 B. Five RTX-local layers leave 35 remote:
#   40 * 2,406,481,920 = 96,259,276,800 B for all layers;
#   35 * 2,406,481,920 = 84,226,867,200 B of remote Spark weight.
# This is the live three-host floor: min(MemTotal) over ostrich/dodo/emu
# (127,533,356 kB, read 2026-09-21) * 1024 - 20 GiB = 109,119,320,064 B,
# identical to the six-host tested floor because dodo is the minimum. That
# leaves 109,119,320,064 - 84,226,867,200 = 24,892,452,864 B of weight-only
# margin. Weight-only admission is not a launch-feasibility claim: workspace,
# load staging and runtime headroom are only known when the expert service
# reports them.
SPARK_DEVICE_BUDGET_BYTES=109119320064
