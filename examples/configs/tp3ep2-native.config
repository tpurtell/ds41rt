# DS41RT example: 1 RTX + 6 Spark, replicated TP3 x EP2.
#
# ============================================================================
# EXPERIMENT COMPLETED, NOT ACCEPTED, NOT RELEASE-QUALIFIED. The six Spark hosts
# are rhea/moa as global ranks 4/5 (see docs/cluster-hosts.md); the 1-RTX
# TP3xEP2 arm loaded all 40 routed layers remotely. Quality was not accepted and
# the release is not qualified; this file carries no memory, correctness,
# performance or readiness claim. rhea/moa are ordinary benchmark/development
# hosts under the current permission. This is an illustrative launch config, not
# the measured artifact; see docs/tp-ep-configuration.md.
# ============================================================================
#
#   ./run.sh --config examples/configs/tp3ep2-native.config --dry-run
#
# group = rank / 3, tp_rank = rank % 3:
#   ostrich,dodo,emu      -> group 0, tp_rank 0,1,2
#   kiwi,rhea,moa         -> group 1, tp_rank 0,1,2
#
# One RTX holds the coordinator's fixed owners with TP1 local routed layers; the
# Spark ranks hold TP3 shards of every routed expert in two replicated groups.

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable

RTX_GPUS=1
# All 40 routed layers stay remote: `auto` on one RTX has no boundary to hand
# off, so workers would over-reserve layers the coordinator keeps locally.
RTX_EXPERT_LAYERS=0

SPARK_COUNT=6
SPARK_TP=3
SPARK_EP=2

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_4_HOST=rhea
SPARK_5_HOST=moa
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
SPARK_4_LANE_A=10.55.0.5
SPARK_5_LANE_A=10.55.0.6

# Isolated secondary rail; native candidate transport still dials LANE_A.
SPARK_0_LANE_B=10.55.1.1
SPARK_1_LANE_B=10.55.1.2
SPARK_2_LANE_B=10.55.1.3
SPARK_3_LANE_B=10.55.1.4
SPARK_4_LANE_B=10.55.1.5
SPARK_5_LANE_B=10.55.1.6

# Promoted release pair (universal images; `run.sh` selects the tp3 role this
# topology needs). Six ranks need the Spark image on rhea/moa too. See README.md.
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v11
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v11

# Budget: MemTotal varies by host. The tested fleet-wide budget is the minimum
# of (MemTotal - 20 GiB) across all six hosts: 109,119,320,064 bytes.
# This overrides the 100 GiB default; runtime load/serve admission still applies.
# Do not substitute a newer host's larger budget or assume 128 GiB.
SPARK_DEVICE_BUDGET_BYTES=109119320064
