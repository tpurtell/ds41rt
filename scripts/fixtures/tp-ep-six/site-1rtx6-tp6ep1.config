# DS41RT staged six-rank config: 1rtx6-tp6ep1 (pure unreplicated TP6, single RTX).
# Copy to runs/tp-ep-six/ and set the REQUIRED image tags from the candidate release.
# The Spark image must advertise the extra `spark_tp6` role
# (DS41RT_RELEASE_SPARK_TP_ROLES=tp6). Launch the isolated candidate process
# (coordinator 127.0.0.1:18000, expert 0.0.0.0:29441), NOT the release run.sh defaults.
#
# Single-RTX standalone using the CURRENT official 1-RTX placement shape: five
# local routed layers and 35 remote (single auto KV, global pool 16,700,672,000).
# TP6 weights for 35 remote layers are 35 * 1203240960 = 42,113,433,600 B per rank;
# an all-40-remote variant is a separate, explicitly measured sidearm, not the
# release-equivalent baseline.
MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable
RTX_GPUS=1
RTX_EXPERT_LAYERS=5
DSPARK=on
SPARK_COUNT=6
SPARK_TP=6
SPARK_EP=1
CONCURRENCY=16
PREFILL_BATCH_TOKENS=2048
PREFIX_CACHE_ENTRIES=20
SPARK_DEVICE_BUDGET_BYTES=109119320064
SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_4_HOST=rhea
SPARK_5_HOST=moa
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
SPARK_4_LANE_A=10.55.0.5
SPARK_5_LANE_A=10.55.0.6

# Isolated secondary rail; native candidate transport still dials LANE_A.
SPARK_0_LANE_B=10.55.1.1
SPARK_1_LANE_B=10.55.1.2
SPARK_2_LANE_B=10.55.1.3
SPARK_3_LANE_B=10.55.1.4
SPARK_4_LANE_B=10.55.1.5
SPARK_5_LANE_B=10.55.1.6
COORDINATOR_DOCKER_INFERENCE=REQUIRED_COORDINATOR_IMAGE
SPARK_EXPERT_DOCKER_INFERENCE=REQUIRED_EXPERT_IMAGE
