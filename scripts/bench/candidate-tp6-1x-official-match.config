# DS41RT official TP6xEP1 candidate - 1 RTX, 5 local / 35 remote.
#
# Matched-comparison arm for the published-v8 official TP4 baseline
# `official-v8-1x-tp4` (RTX_GPUS=1). The placement is pinned to the SAME local
# routed-layer count the baseline measured (5 local, first remote dispatch layer
# 5, 35 remote), so the only intended variable versus the baseline is the Spark
# topology (4 ranks TP4xEP1 -> 6 ranks TP6xEP1). Do not substitute an
# all-40-remote arm for this primary arm; that is a separate, clearly labelled
# optimisation.
#
# Identity is pinned to the baseline: same MODEL_ID/MODEL_REVISION (the official
# quant), same concurrency/prefill/prefix controls, KV left automatic so it
# resolves the same 16,700,672,000-byte global pool the baseline measured.
#
# Cost policy: this file does NOT set it. The default is `auto`, whose resolved
# mode is logged as `cost_model=` and must be recorded. The controlled legacy
# isolation arm exports `DS41RT_ADAPTIVE_COST_MODE=legacy` for BOTH the baseline
# and this arm; see scripts/bench/tp6-candidate-flags.md.
#
# PRIVATE SITE CONFIG - not a shipped default.
# User-unified fabric: rail A 10.55.0.x, isolated rail B 10.55.1.x.
# Keep the management control address separate from the fabric addresses.
# Historical measurements retain their original network configuration.

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
MODEL_REVISION=dba1be0a40aa45a94ad051997016db3960a90277
EXPERT_FORMAT=native
SPARKINFER_EXL3=disable
EXL3_PAIRED_TP4=off

RTX_GPUS=1
RTX_EXPERT_LAYERS=5
COORDINATOR_GPU=0
COORDINATOR_GPU_UUID=GPU-fe5b6dd0-a77c-c8fb-6360-e1b9d9918ac0
COORDINATOR_GPU_PCI_BUS_ID=00000000:11:00.0
COORDINATOR_GPU_HEADROOM_GIB=8

DSPARK=on
CONCURRENCY=16
PREFILL_BATCH_TOKENS=2048
PREFIX_CACHE_ENTRIES=20
MAX_CONTEXT_TOKENS=1048576
MAX_OUTPUT_TOKENS=393216
HOST_CACHE_BYTES=auto
# KV_POOL_SIZE intentionally unset: `auto` reproduces the baseline 1x pool.
# Pin the same explicit bytes on BOTH arms only if you want to remove it as a variable.

# Six physical ranks, one replicated group: group = rank / TP, tp_rank = rank % TP.
SPARK_COUNT=6
SPARK_TP=6
SPARK_EP=1

SPARK_DEVICE_BUDGET_BYTES=109119320064

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_4_HOST=rhea
# Management control path; this does not select the data rail.
SPARK_5_HOST=172.22.2.6

SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
SPARK_4_LANE_A=10.55.0.5
SPARK_5_LANE_A=10.55.0.6

# Rail B inventory does not enable dual-rail transport; the candidate dials LANE_A.
SPARK_0_LANE_B=10.55.1.1
SPARK_1_LANE_B=10.55.1.2
SPARK_2_LANE_B=10.55.1.3
SPARK_3_LANE_B=10.55.1.4
SPARK_4_LANE_B=10.55.1.5
SPARK_5_LANE_B=10.55.1.6

# Fill these with the built v9 candidate images and record the digests.
COORDINATOR_DOCKER_DEV=ds41rt-coordinator-dev
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v9
SPARK_EXPERT_DOCKER_DEV=ds41rt-spark-expert-dev
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v9
