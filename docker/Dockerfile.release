ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3
FROM ${BASE_IMAGE} AS inference

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_SYSTEM_PYTHON=1
ENV PATH=/opt/ds41rt/bin:${PATH}
ENV PYTHONPATH=/opt/ds41rt/third_party/sparkinfer:/opt/ds41rt/python/reference/ds41rt_reference:/opt/ds41rt/python/reference
ENV DS41RT_NATIVE_LIB=/opt/ds41rt/lib/libds41rt_native.so

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates curl jq tini \
      rdma-core ibverbs-providers libibverbs1 \
      libnl-3-200 libnl-route-3-200 \
      iproute2 pciutils netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir uv && \
    uv pip install --system --break-system-packages --no-cache \
      safetensors \
      huggingface-hub \
      "nvidia-cutlass-dsl[cu13]==4.6.2" \
      "apache-tvm-ffi==0.1.12" \
      "cuda-tile==1.5.0" \
      "nvidia-cudnn-frontend==1.26.0" \
      "einops==0.8.2" \
      "ninja==1.13.0" \
      "nvidia-ml-py==13.610.43" \
      "tabulate==0.10.0" \
      "transformers==5.13.0" \
      "rich==15.0.0" && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      "flashinfer-python==0.6.14" && \
    python3 -c 'import torch; print(torch.__version__)'

# The NGC 26.05 base declares pytest as a runtime requirement of its bundled
# triton-kernels distribution. Keep the release environment dependency-complete
# so the source-pinned SparkInfer installation can be checked globally below.
RUN uv pip install --system --break-system-packages --no-cache pytest

# Keep source/revision metadata after the expensive immutable dependency
# layers. Rapid SparkInfer iteration should invalidate only the pinned-source
# and release-material tail of this image.
ARG DS41RT_ROLE
ARG CUDA_ARCH
ARG DS41RT_ENGINE_COMMIT=unknown
ARG DS41RT_SPARKINFER_COMMIT=unknown
ARG DS41RT_RELEASE_VERSION=unknown
# Optional replicated-group SM121 expert roles compiled into this image
# (semicolon list `tp2`/`tp3`). Empty is the release default and keeps the
# historical Spark TP4 shard unchanged.
ARG DS41RT_V41_SPARK_TP_ROLES=

ENV DS41RT_ROLE=${DS41RT_ROLE}
ENV DS41RT_CUDA_ARCH=${CUDA_ARCH}
ENV DS41RT_ENGINE_COMMIT=${DS41RT_ENGINE_COMMIT}
ENV DS41RT_SPARKINFER_COMMIT=${DS41RT_SPARKINFER_COMMIT}
ENV DS41RT_RELEASE_VERSION=${DS41RT_RELEASE_VERSION}
ENV DS41RT_V41_SPARK_TP_ROLES=${DS41RT_V41_SPARK_TP_ROLES}

LABEL org.opencontainers.image.title="DS41RT inference"
LABEL org.opencontainers.image.source="https://github.com/tpurtell/ds41rt"
LABEL org.opencontainers.image.description="DeepSeek V4.1 Flash inference for one or two RTX PRO 6000 GPUs and four DGX Spark expert workers"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.revision=${DS41RT_ENGINE_COMMIT}
LABEL org.opencontainers.image.version=${DS41RT_RELEASE_VERSION}
LABEL io.ds41rt.role=${DS41RT_ROLE}
LABEL io.ds41rt.cuda_arch=${CUDA_ARCH}
LABEL io.ds41rt.sparkinfer.revision=${DS41RT_SPARKINFER_COMMIT}
LABEL io.ds41rt.v41.spark_tp_roles=${DS41RT_V41_SPARK_TP_ROLES}

COPY scripts/verify-sparkinfer-source.py /opt/ds41rt/scripts/verify-sparkinfer-source.py
COPY scripts/sparkinfer-release-provenance.py /opt/ds41rt/scripts/sparkinfer-release-provenance.py
COPY third_party/sparkinfer.lock.json /opt/ds41rt/third_party/sparkinfer.lock.json
COPY third_party/sparkinfer /opt/ds41rt/third_party/sparkinfer

RUN python3 /opt/ds41rt/scripts/verify-sparkinfer-source.py \
      --source /opt/ds41rt/third_party/sparkinfer \
      --lock /opt/ds41rt/third_party/sparkinfer.lock.json && \
    locked_revision="$(python3 /opt/ds41rt/scripts/verify-sparkinfer-source.py \
      --source /opt/ds41rt/third_party/sparkinfer \
      --lock /opt/ds41rt/third_party/sparkinfer.lock.json \
      --print-revision)" && \
    [ "${DS41RT_SPARKINFER_COMMIT}" != unknown ] && \
    [ "${DS41RT_SPARKINFER_COMMIT}" = "$locked_revision" ] && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      --editable /opt/ds41rt/third_party/sparkinfer && \
    uv pip check && \
    python3 -c 'import importlib.metadata, pathlib, b12x; source = pathlib.Path("/opt/ds41rt/third_party/sparkinfer").resolve(); module = pathlib.Path(b12x.__file__).resolve(); assert module.is_relative_to(source), (module, source); print(importlib.metadata.version("b12x"), module)' && \
    python3 /opt/ds41rt/scripts/verify-sparkinfer-source.py \
      --source /opt/ds41rt/third_party/sparkinfer \
      --lock /opt/ds41rt/third_party/sparkinfer.lock.json \
      --require-no-python-cache

COPY .ds41rt-release-image/ds41rt /opt/ds41rt/bin/ds41rt
COPY .ds41rt-release-image/libds41rt_native.so /opt/ds41rt/lib/libds41rt_native.so
COPY .ds41rt-release-image/exl3 /opt/ds41rt/lib/exl3
COPY .ds41rt-release-image/V41_EXPERT_AOT.json /opt/ds41rt/share/V41_EXPERT_AOT.json
COPY .ds41rt-release-image/V41_EXPERT_TP_AOT.json /opt/ds41rt/share/V41_EXPERT_TP_AOT.json
COPY .ds41rt-release-image/V41_FP8_AOT.json /opt/ds41rt/share/V41_FP8_AOT.json
COPY .ds41rt-release-image/THIRD_PARTY_NOTICES.md /opt/ds41rt/share/THIRD_PARTY_NOTICES.md
COPY .ds41rt-release-image/SPARKINFER_PROVENANCE.json /opt/ds41rt/share/SPARKINFER_PROVENANCE.json
COPY .ds41rt-release-image/SPARKINFER_LICENSE /opt/ds41rt/share/SPARKINFER_LICENSE
COPY .ds41rt-release-image/SPARKINFER_SHA256SUMS /opt/ds41rt/share/SPARKINFER_SHA256SUMS
COPY .ds41rt-release-image/XGRAMMAR_PROVENANCE.json /opt/ds41rt/share/XGRAMMAR_PROVENANCE.json
COPY .ds41rt-release-image/XGRAMMAR_LICENSE /opt/ds41rt/share/XGRAMMAR_LICENSE
COPY .ds41rt-release-image/XGRAMMAR_SHA256SUMS /opt/ds41rt/share/XGRAMMAR_SHA256SUMS
COPY python /opt/ds41rt/python
COPY scripts/real-full-tcp-serve.sh /opt/ds41rt/scripts/real-full-tcp-serve.sh
COPY scripts/kernel-cache-identity.py /opt/ds41rt/scripts/kernel-cache-identity.py
COPY docker/release-entrypoint.sh /usr/local/bin/ds41rt-release-entrypoint

RUN for exl3_family in /opt/ds41rt/lib/exl3/exl3-k*/; do \
      python3 /opt/ds41rt/python/tools/package_v41_exl3_aot.py verify \
        --package "$exl3_family" --sparkinfer-revision "$DS41RT_SPARKINFER_COMMIT" \
        --role "$DS41RT_ROLE" --runtime "$(python3 -m cutlass.cute.export.aot_config --libdir)/libcute_dsl_runtime.so"; \
    done && \
    cmp -s \
      /opt/ds41rt/third_party/sparkinfer/LICENSE \
      /opt/ds41rt/share/SPARKINFER_LICENSE && \
    (cd /opt/ds41rt/share && sha256sum -c SPARKINFER_SHA256SUMS) && \
    (cd /opt/ds41rt/share && sha256sum -c XGRAMMAR_SHA256SUMS) && \
    python3 /opt/ds41rt/scripts/sparkinfer-release-provenance.py \
      --source /opt/ds41rt/third_party/sparkinfer \
      --lock /opt/ds41rt/third_party/sparkinfer.lock.json \
      --license /opt/ds41rt/share/SPARKINFER_LICENSE \
      --notices /opt/ds41rt/share/THIRD_PARTY_NOTICES.md \
      --verify /opt/ds41rt/share/SPARKINFER_PROVENANCE.json && \
    install -D -m 0644 \
      /opt/ds41rt/share/SPARKINFER_LICENSE \
      /opt/ds41rt/share/licenses/sparkinfer/LICENSE && \
    install -D -m 0644 \
      /opt/ds41rt/share/XGRAMMAR_LICENSE \
      /opt/ds41rt/share/licenses/xgrammar/LICENSE && \
    chmod +x \
      /opt/ds41rt/bin/ds41rt \
      /opt/ds41rt/scripts/real-full-tcp-serve.sh \
      /usr/local/bin/ds41rt-release-entrypoint && \
    python3 -c 'import b12x_mla_capture, b12x_spark_capture, triton_kv_pack_capture, triton_mlp_capture, triton_router_capture, triton_sampling_capture'

WORKDIR /opt/ds41rt
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/ds41rt-release-entrypoint"]
CMD ["ds41rt", "--help"]
