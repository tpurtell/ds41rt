# DS41RT v12 RELEASE BUILD TARGET — ./build.sh --config ds41rt.build-v12.config.
#
# build.sh derives the release tag from the coordinator image reference below, so
# this file is what selects `v12` for a build. It is NOT yet identical to
# ds41rt.config: the runtime default still names the published `:v11` pair and is
# promoted to `:v12` only in the release promotion change, after the v12 image
# pair is qualified and published (docs/OPERATIONS.md; docs/release-v12-checklist.md).
# See docs/release-v12-notes.md.
#
# The only intended difference from ds41rt.config is the release pair. Verify with:
#   diff <(grep -v '^#' ds41rt.config) <(grep -v '^#' ds41rt.build-v12.config)

#################
# DeepSeek model #
#################

MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
MODEL_VARIANT=flash
MODEL_REVISION=dba1be0a40aa45a94ad051997016db3960a90277

# The standard v6 configuration runs the official V4.1 checkpoint without conversion.
EXPERT_FORMAT=native

# The source KV cache uses FP4 E2M1/group-16 with E4M3 scales. SWA remains FP8.
# Production admits up to sixteen requests across the two native execution lanes.
DSPARK=on

# Experimental dual-RTX options; none has established a consistent decode win.
# Attention replicates KV. Draft TP2 splits routed experts only and requires
# native expert weights and DSPARK=on. Each switch is independent.
TP2_ATTENTION=off
TP2_QUERY_PROJECTION=off
TP2_OUTPUT_PROJECTION=off
TP2_DSPARK_EXPERTS=off

# Use two RTX cards when the calibrated deployment fits available memory and
# bidirectional peer reads are supported. Set 1 or 2 to force a layout.
RTX_GPUS=auto

# This host GPU becomes logical RTX0. The automatically selected peer becomes
# logical RTX1. Pin both fields below to keep RTX0 tied to a physical card even
# if host ordinals change after a reboot.
COORDINATOR_GPU=0
# For a portable first run these are resolved from COORDINATOR_GPU. Pin both
# values from `nvidia-smi` in a site-local config once the host is selected.
COORDINATOR_GPU_UUID=
COORDINATOR_GPU_PCI_BUS_ID=
COORDINATOR_GPU_HEADROOM_GIB=8

# With no explicit pool size or memory ceiling, dual mode targets a 14M-token
# shared pool plus COW/tail allowance. Both controls
# accept decimal/binary byte units; MEMORY_RESERVATION also accepts percentages.
# Remaining memory automatically holds complete routed-expert layers from layer 0,
# after reserving KV, execution workspaces, load staging and runtime headroom.
# KV_POOL_SIZE=22.5GB
# MEMORY_RESERVATION=90%
MAX_CONTEXT_TOKENS=1048576
MAX_OUTPUT_TOKENS=393216
CONCURRENCY=16
PREFIX_CACHE_ENTRIES=20
# Size RAM paging so GPU + RAM token capacity exceeds retention slots * max context.
# auto also reserves snapshot overhead and restore staging; 0 disables RAM paging.
HOST_CACHE_BYTES=auto
PREFILL_BATCH_TOKENS=2048

####################
# SparkInfer expert #
####################

# Each Spark owns one TP rank and uses the next supported AOT capacity at or
# above PREFILL_BATCH_TOKENS. The budget includes resident experts and workspace.
SPARK_DEVICE_BUDGET_BYTES=107374182400
SPARKINFER_EXL3=disable
# Build paired H128 Spark kernels with two blocks/SM at capacity 80.
# run.sh selects ownership from matching image manifests for EXL3 checkpoints.
EXL3_PAIRED_TP4=off

##############
# Networking #
##############

ADDR=0.0.0.0:8000
EXPERT_PORT=19441

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
# Fifth/sixth connected hosts. The default SPARK_COUNT=4 serving selection does
# not launch them, but stop.sh cleans up every configured host, so naming them
# lets a cleanup reach containers a previous six-rank run left behind. An
# explicit six-rank topology (examples/configs/*ep*-native.config) selects them.
SPARK_4_HOST=rhea
SPARK_5_HOST=moa
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
SPARK_4_LANE_A=10.55.0.5
SPARK_5_LANE_A=10.55.0.6

# Optional secondary Spark-to-Spark reduction rail: set a value for every
# active SPARK rank or for none (all-or-none over the configured ranks; the
# shipped default now names all six). The candidate native launcher is
# single-rail A-only, so these are unused unless a four-Spark secondary-rail
# launch explicitly selects them.
SPARK_0_LANE_B=10.55.1.1
SPARK_1_LANE_B=10.55.1.2
SPARK_2_LANE_B=10.55.1.3
SPARK_3_LANE_B=10.55.1.4
SPARK_4_LANE_B=10.55.1.5
SPARK_5_LANE_B=10.55.1.6

####################
# Build and deploy #
####################

COORDINATOR_DOCKER_DEV=ds41rt-coordinator-dev
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-coordinator:v12
SPARK_EXPERT_DOCKER_DEV=ds41rt-spark-expert-dev
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds41rt-spark-expert:v12
